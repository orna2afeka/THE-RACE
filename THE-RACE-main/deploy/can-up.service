[Unit]
# Brings the CAN interfaces up at boot, as root, before anything needs them.
#
# This is the RIGHT place to do it. main.py can also bring the bus up, but under
# an autostarted desktop session it has no terminal to answer a sudo password
# prompt — and granting the GUI app passwordless root for `ip` would effectively
# give it full root (`ip netns exec` runs arbitrary commands). systemd already
# runs as root at boot, so the app needs no privileges at all.
Description=Bring SolarRace CAN interfaces up
After=sys-subsystem-net-devices-can0.device
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The two channels run at DIFFERENT rates and must match config.CAN_BITRATES
# entry for entry. systemd cannot read config.py, so these numbers are copied
# by hand — change one, change the other. Every device on a given wire has to
# agree with that wire's rate, and a wrong bitrate looks exactly like a dead
# bus: the interface comes up clean and simply never decodes a frame.
#
# can0 — 1 Mbit/s
# Reset both links first. `ip link set canX up` FAILS with "Device or resource
# busy" on an interface that is already up — which is exactly what happens when
# main.py brought the bus up itself, or when this unit is restarted after a
# previous run. Without these, a restart on a healthy car fails the whole unit.
# The '-' means "ignore failure", so a link that does not exist yet is fine too.
ExecStartPre=-/usr/sbin/ip link set can0 down
ExecStartPre=-/usr/sbin/ip link set can1 down

ExecStart=/usr/sbin/ip link set can0 up type can bitrate 1000000
# The default CAN TX queue is ~10 frames and the BMS poller sends a 16-frame
# burst, which overflows it as ENOBUFS. This is why the queue is raised.
ExecStart=/usr/sbin/ip link set can0 txqueuelen 65536
# can1 — 500 kbit/s. Optional: a single-HAT car does not have it, and mixed
# rates need two independent controllers (a 2-channel HAT), not one MCP2515.
# The leading '-' makes systemd ignore the failure instead of marking the
# whole unit failed.
ExecStart=-/usr/sbin/ip link set can1 up type can bitrate 500000
ExecStart=-/usr/sbin/ip link set can1 txqueuelen 65536
ExecStop=-/usr/sbin/ip link set can0 down
ExecStop=-/usr/sbin/ip link set can1 down

[Install]
WantedBy=multi-user.target
