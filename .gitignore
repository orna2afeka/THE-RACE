# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
**/venv/
**/.venv/
REACT_MIGRATION_PROMPT.md
# ---------------------------------------------------------------------------
# Pit-side telemetry store
# ---------------------------------------------------------------------------
# collector.py writes telemetry.db locally on each pit machine. It is local
# state, not source: never commit it.
*.db
*.db-wal
*.db-shm

# Manual snapshots taken before risky migrations (tens of MB each).
*.bak
**/*.bak

# ---------------------------------------------------------------------------
# Firebase credentials
# ---------------------------------------------------------------------------
# Real service-account keys for the solar-race-telemetry Firebase project.
# NEVER commit these -- this repo is public. Get your own copy from the
# team's shared folder (see README) and drop it in place; both collector.py
# and main.py load it from these exact paths.
#
# This is not a hypothetical: a key WAS committed here for 12 days across 49
# commits before this line was added, and was purged from history with
# git-filter-repo. That key must be treated as compromised regardless -- see
# the README note next to this same warning.
Pit_Dashboard/serviceAccountKey.json
SolarRace_OS/cloud/serviceAccountKey.json

# ---------------------------------------------------------------------------
# Car-side runtime state
# ---------------------------------------------------------------------------
# main.py writes this on the Pi so a reboot mid-race resumes the running
# distance/energy totals instead of restarting from zero. Local state, not
# source: never commit it, same reasoning as telemetry.db above.
SolarRace_OS/lap_checkpoint.json
SolarRace_OS/lap_checkpoint.json.tmp

# ---------------------------------------------------------------------------
# Launcher / runtime bookkeeping
# ---------------------------------------------------------------------------
# Hash of the last requirements file run_pit.bat pip-installed.
.deps_stamp
**/.deps_stamp
docs/*
!docs/REACT_MIGRATION_PLAN.md
# collector stdout/stderr when launched detached by run_pit.bat
collector.out.log
collector.err.log

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.Rhistory
Thumbs.db
desktop.ini

tools/
